{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-obsidian-second-brain/config.schema.json",
  "title": "Second Brain local runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "vault": {
      "type": "string",
      "minLength": 3,
      "pattern": "^(?:[A-Za-z]:[\\\\/]|/).+",
      "description": "Absolute local vault path supplied at install/runtime. It must never be committed or included in a release. Environment variable SECOND_BRAIN_VAULT takes precedence."
    },
    "dataDir": {
      "type": "string",
      "minLength": 3,
      "pattern": "^(?:[A-Za-z]:[\\\\/]|/).+",
      "description": "Optional local derived-data directory override. Environment variable SECOND_BRAIN_DATA_DIR takes precedence."
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional overrides for the vault structure conventions. Every value is a vault-relative path; unknown keys, absolute paths, and parent traversal are rejected.",
      "properties": {
        "projectsDir": { "type": "string", "minLength": 1, "default": "02-项目" },
        "projectHome": { "type": "string", "minLength": 1, "default": "项目主页.md" },
        "memoryDir": { "type": "string", "minLength": 1, "default": "01-长期记忆" },
        "conversationDir": { "type": "string", "minLength": 1, "default": "04-对话纪要" },
        "workflowDir": { "type": "string", "minLength": 1, "default": "05-工作流" },
        "vaultRuleFile": { "type": "string", "minLength": 1, "default": "AGENTS.md" },
        "projectInputDir": { "type": "string", "minLength": 1, "default": "01-输入" },
        "projectProcessDir": { "type": "string", "minLength": 1, "default": "02-过程" },
        "projectOutputDir": { "type": "string", "minLength": 1, "default": "03-输出" },
        "projectFeedbackDir": { "type": "string", "minLength": 1, "default": "04-反馈" },
        "homeNotes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Vault-root notes indexed by global search."
        },
        "governanceFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Highest-authority notes available to every project-scoped search."
        }
      }
    }
  }
}
